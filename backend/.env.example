# DealFlow360 — Environment Configuration Template (.env.example)
NODE_ENV = dev # dev, prod, local
SERVICE_NAME = dealflow360
SERVER_PORT = 3023

# JWT Secret
JWT_SECRET = your_jwt_secret_key_here

# PostgreSQL Database Configuration
DB_HOST = localhost
DB_PORT = 5432
DB_NAME = dealflow360
DB_USER = postgres
DB_PASSWORD = postgres

# Dbmate Connection String
DATABASE_URL = "postgres://postgres:postgres@localhost:5432/dealflow360?sslmode=disable"

# Logger Options
CONSOLE_LOG_LEVEL = info
FILE_LOG_LEVEL = false

# External Integrations (Optional)
WHATSAPP_SERVICE = false

EMAIL_ID = admin@dealflow360.com
EMAIL_PASSWORD = password
EMAIL_SMTP_HOST = smtp.gmail.com
EMAIL_SMTP_PORT = 587

# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID = your_twilio_account_sid_here
TWILIO_AUTH_TOKEN = your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER = whatsapp:+14155238886
TWILIO_WHATSAPP_JOIN_MESSAGE = join stand-exclaimed
TWILIO_WHATSAPP_SANDBOX_NUMBER = +1 415 523 8886

# Frontend Configuration (CORS Origin)
FRONTEND_URL = http://localhost:5173

# Razorpay Configuration
RAZORPAY_KEY_ID = your_razorpay_key_id_here
RAZORPAY_KEY_SECRET = your_razorpay_key_secret_here


