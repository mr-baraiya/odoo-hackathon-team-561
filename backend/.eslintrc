{
  "env": {
    "node": true,
    "commonjs": true
  },
  "parserOptions": {
    "ecmaVersion": 12
  },
  "extends": ["airbnb-base"],
  "rules": {
    "no-console": 0,
    "camelcase": 0,
    "no-underscore-dangle": 0,
    "object-curly-newline": 0,
    "no-unused-vars": ["error", { "argsIgnorePattern": "next" }],
    "no-use-before-define": ["error", { "variables": false }],
    "no-multi-str": 0,
    "max-len": "off",
    "import/no-unresolved": "off",
    "import/extensions": "off",
    "padded-blocks": "off"
  }
}
